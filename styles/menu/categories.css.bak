/* =========================================================
   MITHORA MENU — CATEGORY NAVIGATION
   Clean / transparent / compact / responsive
   ========================================================= */


/* =========================================================
   CATEGORY WRAPPER
   ========================================================= */

.menu-categories-wrapper {
  width: 100%;
  height: auto;

  margin: 0 !important;
  padding: 0 !important;

  overflow: hidden;

  background: transparent !important;

  border: 0 !important;
  border-top: 0 !important;
  border-right: 0 !important;
  border-bottom: 0 !important;
  border-left: 0 !important;

  box-shadow: none !important;
}


/* =========================================================
   CATEGORY ROW
   ========================================================= */

.menu-categories {
  display: flex;
  align-items: flex-start;

  width: 100%;
  height: auto;

  margin: 0 !important;

  padding: 10px 4px 6px;

  gap: 24px;

  overflow-x: auto;
  overflow-y: hidden;

  scrollbar-width: none;

  background: transparent !important;

  border: 0 !important;
  box-shadow: none !important;
}

.menu-categories::-webkit-scrollbar {
  display: none;
}


/* Remove any accidental pseudo-elements */

.menu-categories-wrapper::before,
.menu-categories-wrapper::after,
.menu-categories::before,
.menu-categories::after {
  display: none !important;
  content: none !important;
}


/* =========================================================
   CATEGORY ITEM
   ========================================================= */

.menu-category-item {
  flex-shrink: 0;

  display: flex;
  flex-direction: column;
  align-items: center;

  width: 82px;

  margin: 0 !important;
  padding: 0 !important;

  background: transparent !important;

  border: 0 !important;
  box-shadow: none !important;

  color: var(--dark-brown, #2d1b14);

  font-family:
    Inter,
    Arial,
    sans-serif;

  cursor: pointer;
}


/* =========================================================
   CATEGORY IMAGE CIRCLE
   ========================================================= */

.menu-category-image {
  width: 64px;
  height: 64px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border-radius: 50%;

  background: #f4eee2;

  border: 2px solid transparent;

  box-shadow:
    0 3px 10px rgba(45, 27, 20, 0.07);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}


/* Actual image */

.menu-category-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: 50%;
}


/* =========================================================
   CATEGORY NAME
   ========================================================= */

.menu-category-item > span {
  display: -webkit-box;

  width: 100%;

  margin: 6px 0 0;
  padding: 0;

  overflow: hidden;

  color: #4d4038;

  font-size: 11px;
  font-weight: 700;

  line-height: 14px;

  text-align: center;

  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}


/* =========================================================
   ACTIVE CATEGORY
   ========================================================= */

.menu-category-item.active .menu-category-image {
  border-color:
    var(--primary-orange, #ff6b35);

  transform: scale(1.04);

  box-shadow:
    0 4px 12px
    rgba(255, 107, 53, 0.16);
}

.menu-category-item.active > span {
  color:
    var(--primary-orange, #ff6b35);
}


/* =========================================================
   HOVER
   ========================================================= */

.menu-category-item:hover .menu-category-image {
  transform: translateY(-2px);
}


/* =========================================================
   DESKTOP
   ========================================================= */

@media (min-width: 1200px) {

  .menu-categories-wrapper {
    margin: 0 !important;
    padding: 0 !important;

    background: transparent !important;

    border: 0 !important;
    box-shadow: none !important;
  }

  .menu-categories {
    justify-content: center;

    gap: 30px;

    padding: 12px 4px 7px;

    background: transparent !important;

    border: 0 !important;
    box-shadow: none !important;
  }

  .menu-category-item {
    width: 92px;
  }

  .menu-category-image {
    width: 72px;
    height: 72px;
  }

  .menu-category-item > span {
    margin-top: 6px;

    font-size: 12px;
    line-height: 15px;
  }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {

  .menu-categories-wrapper {
    width: 100%;

    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;

    margin: 0 !important;
    padding: 0 !important;

    overflow: hidden;

    background: transparent !important;

    border: 0 !important;
    border-top: 0 !important;
    border-bottom: 0 !important;

    box-shadow: none !important;
  }

  .menu-categories {
    justify-content: flex-start;

    width: 100%;
    height: auto !important;
    min-height: 0 !important;

    gap: 12px;

    margin: 0 !important;

    padding: 7px 10px 3px !important;

    overflow-x: auto;
    overflow-y: hidden;

    background: transparent !important;

    border: 0 !important;
    border-top: 0 !important;
    border-bottom: 0 !important;

    box-shadow: none !important;
  }

  .menu-category-item {
    width: 64px;

    margin: 0 !important;
    padding: 0 !important;

    background: transparent !important;

    border: 0 !important;
    box-shadow: none !important;
  }

  .menu-category-image {
    width: 52px;
    height: 52px;

    border-width: 2px;
  }

  .menu-category-item > span {
    margin-top: 4px;

    font-size: 9px;
    line-height: 11px;

    min-height: 11px;

    color: #4d4038;
  }
}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media (max-width: 380px) {

  .menu-categories {
    gap: 10px;

    padding-left: 8px !important;
    padding-right: 8px !important;
  }

  .menu-category-item {
    width: 62px;
  }

  .menu-category-image {
    width: 50px;
    height: 50px;
  }

  .menu-category-item > span {
    font-size: 8.5px;
    line-height: 10px;
  }
}


/* =========================================================
   REMOVE DIVIDERS AROUND CATEGORY SECTION
   ========================================================= */

.menu-categories-wrapper,
.menu-categories-wrapper *,
.menu-categories {
  border-bottom: 0 !important;
}


/* If the category wrapper is immediately followed by
   the intro/hero, don't create an artificial gap. */

.menu-categories-wrapper + section,
.menu-categories-wrapper + div {
  margin-top: 0 !important;
}


/* =========================================================
   MOBILE — PREVENT CATEGORY SECTION FROM CREATING GAP
   ========================================================= */

@media (max-width: 767px) {

  .menu-categories-wrapper + section,
  .menu-categories-wrapper + div {
    margin-top: 0 !important;
    padding-top: 0 !important;

    border-top: 0 !important;
    box-shadow: none !important;
  }
}